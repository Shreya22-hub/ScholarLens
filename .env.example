# ScholarLens Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
FRONTEND_PUBLIC_URL=http://localhost:8501

# Frontend Configuration
FRONTEND_PORT=8501
BACKEND_API_URL=http://127.0.0.1:8000

# Configuration & Data Paths
SOURCES_CONFIG_PATH=config/sources.json
DATABASE_PATH=data/scholarlens.db

# Ingestion Settings
USER_AGENT="ScholarLens/1.0 (+https://scholar-lens.gov.in; Academic & Verification Research)"
FETCH_TIMEOUT_SECONDS=15.0
MAX_FETCH_RETRIES=2
RESPECT_ROBOTS_TXT=true
